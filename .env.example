# ── Required ─────────────────────────────────────────────────────────
# Get a free API key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── Trend Scout ──────────────────────────────────────────────────────
REGION_CODE=US                  # ISO 3166-1 alpha-2 (US, ID, GB, etc.)
VIDEO_CATEGORY_ID=24            # 24=Entertainment, 20=Gaming, 10=Music, etc.
MIN_DURATION_S=300              # Minimum video duration (seconds) — default 5 min
MAX_DURATION_S=3600             # Maximum video duration (seconds) — default 60 min
MAX_TRENDING_RESULTS=20         # How many trending videos to check per run

# ── Cobalt API (video downloader) ────────────────────────────────────
COBALT_API_URL=http://localhost:9000

# ── Clipping Settings ────────────────────────────────────────────────
CLIPS_PER_VIDEO=3               # How many shorts to extract per video
CLIP_LENGTH_S=30                # Target clip length in seconds
GOAL_PRESET=tiktok              # tiktok | shorts | podcast

# ── Add-ons ──────────────────────────────────────────────────────────
SUBTITLES=true                  # Auto-subtitles via Whisper
FACE_TRACK=true                 # Speaker-aware 9:16 crop
SAFETY_BOOST=true               # Monetization-safety transforms
CAPTION_STYLE=hype_emoji        # hype_emoji | hype | classic
SUBTITLE_LANGUAGE=auto          # auto | en | id | es | etc.
